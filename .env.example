# Database Configuration
# Get these from your Supabase project settings
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/DB_NAME?pgbouncer=true
DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Supabase Configuration
# Get these from your Supabase project API settings
SUPABASE_URL=https://your-instance-name.supabase.co
SUPABASE_ANON_PUBLIC=your-anon-public-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# Application Configuration
SESSION_SECRET=generate-a-random-secret-here
SERVER_URL=http://localhost:3000
APP_NAME=Shelf
PORT=3000
NODE_ENV=development

# Feature Flags
ENABLE_PREMIUM_FEATURES=true
DISABLE_SIGNUP=false
DISABLE_SSO=false

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_ENDPOINT_SECRET=
FREE_TRIAL_DAYS=14

# Email Configuration (Optional but recommended)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=some-email@example.com
SMTP_PWD=super-safe-password
SMTP_FROM=
SEND_ONBOARDING_EMAIL=true

# Map Configuration (Optional)
MAPTILER_TOKEN=
GEOCODING_USER_AGENT=shelf.nu

# Analytics (Optional)
MICROSOFT_CLARITY_ID=

# Security
INVITE_TOKEN_SECRET=another-random-secret-here
FINGERPRINT=

# Monitoring (Optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=

# Admin Configuration
ADMIN_EMAIL=
